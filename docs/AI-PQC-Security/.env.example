# Copy this file to .env and replace the example values locally.
# Never commit your real .env file.
DB_PASSWORD=replace_with_your_mysql_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
MONITORING_API_KEY=replace_with_a_random_internal_service_key
AI_SECURITY_SERVICE_URL=http://localhost:8090
AI_MODEL_PATH=./ml/models/promoted/model.joblib
PROMETHEUS_CONFIG=./infrastructure/monitoring/prometheus.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_random_local_dashboard_password

# Optional passive gateway auth observation. Keep disabled until intentionally enabled.
# If enabled, choose an absolute NEW filename under ml/artifacts for each run.
GATEWAY_SHADOW_ENABLED=false
GATEWAY_SHADOW_OUTPUT=
GATEWAY_SHADOW_MAX_PEERS=1024
GATEWAY_SHADOW_MAX_EVENTS_PER_PEER=128
# Optional server-generated join header for an explicitly isolated labelled lab only.
GATEWAY_SHADOW_EXPOSE_OBSERVATION_ID=false
# v2 adds experimental in-memory credential-context history; still passive, off by default.
GATEWAY_SHADOW_FEATURE_VERSION=v1
