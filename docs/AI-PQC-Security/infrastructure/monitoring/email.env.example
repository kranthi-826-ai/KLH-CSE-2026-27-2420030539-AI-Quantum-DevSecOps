# Copy to root .env.email (Git-ignored). Use provider-specific SMTP/app credentials.
# Do not paste real values into chat or commit them. No email is sent by configuration preparation.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=alerts@example.com
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=REPLACE_WITH_PROVIDER_APP_PASSWORD
ALERT_EMAIL_TO=operator@example.com
